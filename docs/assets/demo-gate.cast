{"version": 2, "width": 118, "height": 30, "timestamp": 1786839236, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.212504, "o", "\r\n\u001b[1m$ baglens gate ~/data/episodes --out manifest.json --max-gap 0.5\u001b[0m\r\n"]
[1.212933, "o", "\r\n  \u001b[2mauditing every episode — single pass each, bounded state\u001b[0m\r\n"]
[25.747607, "o", "\r\n  14 episodes\r\n    \u001b[32maccept 9\u001b[0m   \u001b[33mreview 0\u001b[0m   \u001b[31mreject 5\u001b[0m\r\n    \u001b[2m2294s safe to train on, 3746s withheld\u001b[0m\r\n"]
[26.947348, "o", "\r\n  \u001b[1mwhy each rejection was rejected\u001b[0m\r\n    \u001b[31m   5\u001b[0m  gap\r\n"]
[27.247783, "o", "    \u001b[31m   2\u001b[0m  unassessable\r\n"]
[27.54799, "o", "    \u001b[31m   1\u001b[0m  truncated\r\n"]
[27.848212, "o", "    \u001b[31m   1\u001b[0m  recorder_stall\r\n"]
[28.148592, "o", "    \u001b[31m   1\u001b[0m  clock_lag\r\n"]
[28.448869, "o", "\r\n"]
[29.649027, "o", "\r\n  \u001b[2ma reason is not a score — here are three, verbatim from the manifest:\u001b[0m\r\n\r\n"]
[29.649377, "o", "    \u001b[31mreject\u001b[0m dongkkka_00_episode_truncate.mcap\r\n"]
[29.649799, "o", "      \u001b[2mthe file is incomplete, so the episode ends before the demonstration does — absence of data\u001b[0m\r\n"]
[29.900236, "o", "      \u001b[2mafter that point is not absence of events\u001b[0m\r\n"]
[30.150585, "o", "    \u001b[31mreject\u001b[0m fastlivo_hku2_episode_stall.mcap\r\n"]
[30.151113, "o", "      \u001b[2mthe recording is 16.0s long (floor 20s) — shorter than the cadence warmup, so no baseline was\u001b[0m\r\n"]
[30.401172, "o", "      \u001b[2mestablished and every threshold below would be a guess\u001b[0m\r\n"]
[30.651461, "o", "    \u001b[31mreject\u001b[0m nuway_waypoints_episode_dropout.mcap\r\n"]
[30.651735, "o", "      \u001b[2m/sbg/ekf_nav was silent for 15.01s in one stretch (limit 0.50s) — whatever the robot did in\u001b[0m\r\n"]
[30.902066, "o", "      \u001b[2mthat window is missing from the demonstration\u001b[0m\r\n"]
[31.152216, "o", "\r\n"]
[32.352486, "o", "\r\n  \u001b[36mmanifest.json\u001b[0m\u001b[2m carries the decision, the reasons and the policy it ran under,\u001b[0m\r\n  \u001b[2mplus a `train_on` list your training job reads directly.\u001b[0m\r\n"]
[34.552948, "o", "\r\n"]
